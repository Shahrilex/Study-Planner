<UserControl x:Class="StudyPlanner.App.Controls.CivilTopicPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Grid>
        <Button Content="{Binding DisplayText, ElementName=Root}" Click="OpenPicker_Click"
                HorizontalContentAlignment="Right" Padding="6,3"/>
        <Popup x:Name="PickerPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#1F3B57" BorderThickness="1" CornerRadius="4"
                    Padding="8" Width="360" MaxHeight="420">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="تأیید" Click="ClosePicker_Click"
                            Margin="0,8,0,0" Padding="8,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OptionsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
